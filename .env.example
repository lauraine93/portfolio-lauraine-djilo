# --- Base de données ---------------------------------------------------------
# En local : SQLite, rien à installer.
# En production : l'adresse « pooled » de Neon (postgresql://…-pooler…/neondb?sslmode=require)
DATABASE_URL=file:./portfolio.db

# --- Sécurité ----------------------------------------------------------------
# Clé secrète longue et aléatoire, différente pour chaque environnement.
PAYLOAD_SECRET=

# --- Premier lancement en production ----------------------------------------
# Compte administratrice créé automatiquement au premier démarrage s'il n'en existe aucun.
# Après la première connexion, changez le mot de passe dans le back-office puis supprimez ces deux variables.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Adresse publique --------------------------------------------------------
# Facultatif sur Vercel (le domaine de production est détecté). Obligatoire ailleurs.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Images et CV ------------------------------------------------------------
# Ajouté automatiquement par Vercel quand vous créez un stockage « Blob » relié au projet.
BLOB_READ_WRITE_TOKEN=

# --- Contenu d'exemple -------------------------------------------------------
# true en local pour voir les projets d'exemple, false en production.
SHOW_EXAMPLE_CONTENT=true
