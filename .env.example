# Base de données
# - en local : SQLite, rien à installer
# - en production : une URL PostgreSQL (Neon, Supabase…), par exemple postgres://user:pass@host/db
DATABASE_URL=file:./portfolio.db

# Clé secrète longue et aléatoire (openssl rand -hex 32)
PAYLOAD_SECRET=

# Adresse publique du site (sans barre finale)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# true pendant le développement pour afficher les projets d'exemple (jamais en production)
SHOW_EXAMPLE_CONTENT=true
